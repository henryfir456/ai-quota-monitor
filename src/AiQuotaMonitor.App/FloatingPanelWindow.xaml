<Window x:Class="AiQuotaMonitor.App.FloatingPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 額度 · 精簡面板"
        Width="440"
        Height="250"
        MinWidth="360"
        MinHeight="190"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="{Binding Settings.FloatingAlwaysOnTop}"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="刷新" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanManualRefresh}" AutomationProperties.Name="刷新 quota 資料" />
                <Button Content="主視窗" Click="ShowMainWindow_Click" AutomationProperties.Name="顯示主視窗" />
            </StackPanel>
            <TextBlock Text="AI 額度監控器" FontWeight="SemiBold" VerticalAlignment="Center" MouseLeftButtonDown="Header_MouseLeftButtonDown" />
        </DockPanel>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Providers}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryForeground}" FontSize="10" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Windows}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SecondaryForeground}" FontSize="10" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentageText}" FontWeight="SemiBold" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedForeground}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="2,6,2,0" />
    </Grid>
</Window>
