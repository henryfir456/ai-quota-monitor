<Application x:Class="AiQuotaMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AiQuotaMonitor.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <vm:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource InsetBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource InsetBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                <Setter Property="Padding" Value="4,3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
