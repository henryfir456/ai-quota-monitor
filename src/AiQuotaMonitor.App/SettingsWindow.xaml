<Window x:Class="AiQuotaMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="440"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="監控與提醒" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="自動刷新間隔（60～1800 秒）" Foreground="{DynamicResource SecondaryForeground}" />
            <TextBox x:Name="RefreshSecondsBox" Width="120" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
        <CheckBox x:Name="LowAlertsCheckBox" Grid.Row="2" Content="啟用低額度系統匣提醒" Margin="0,22,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="24,12,0,0">
            <TextBlock Text="剩餘低於" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}" />
            <ComboBox x:Name="AlertThresholdBox" Width="90" Margin="12,0,0,0" />
            <TextBlock Text="% 時提醒" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SecondaryForeground}" />
        </StackPanel>
        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="4" Content="登入 Windows 時啟動（預設關閉）" Margin="0,20,0,0" />
        <CheckBox x:Name="FloatingAlwaysOnTopCheckBox" Grid.Row="5" Content="精簡浮動面板保持最上層" Margin="0,18,0,0" />
        <TextBlock Grid.Row="6"
                   Text="只提醒最新且受支援的實際來源資料。UNKNOWN、過期或查詢失敗時不提醒。Claude 需手動設定官方 statusline；Monitor 不會修改 Claude 設定。"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryForeground}"
                   Margin="0,20,0,0" />
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="90" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="儲存" Width="90" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
